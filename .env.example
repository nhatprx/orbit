# Orbit Environment Template (Local Development)
# Copy this file to .env for local configuration. Never commit real secrets.

# Frontend (Vite)
# Point to the live EC2 backend so you do not need to run backend locally:
VITE_API_BASE_URL=https://api.orbit.nhatprx.com

# PostgreSQL (only required if running backend locally)
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orbit
SPRING_DATASOURCE_USERNAME=orbit
SPRING_DATASOURCE_PASSWORD=orbit_dev

# Redis (only required if running backend locally)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Backend Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Workspace platform (all optional; the defaults are shown)
# Days a soft-deleted workspace stays restorable before the hourly purge removes it
ORBIT_WORKSPACE_RETENTION_DAYS=30
ORBIT_WORKSPACE_PURGE_ENABLED=true
ORBIT_WORKSPACE_PURGE_CRON=0 15 * * * *
# Lifetime of email invitations and invite links
ORBIT_INVITATION_EXPIRY_DAYS=7
# Redis pub/sub fan-out and rate limiting for chat. Keep true on every deployed instance.
# false is for single-instance development only (local delivery, no chat rate limit).
ORBIT_CHAT_REDIS_ENABLED=true

# JWT Authentication
JWT_SECRET=replace-with-a-64-char-random-secret-key-for-hs256-signing
JWT_EXPIRATION_SECONDS=3600
JWT_REMEMBER_ME_EXPIRATION_SECONDS=2592000

# Google OAuth2
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# GitHub OAuth2
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# AWS S3 Storage
AWS_S3_ENABLED=false
AWS_S3_BUCKET=orbit-storage-815802019553
AWS_REGION=ap-southeast-1
AWS_S3_PRESIGN_DURATION_MINUTES=15
# Optional CloudFront or public CDN base URL for serving S3 objects (leave empty to use presigned GET URLs)
AWS_S3_PUBLIC_BASE_URL=

# Cloud Files Storage (local MinIO defaults; override with AWS values for production)
AWS_CLOUD_FILES_BUCKET=orbit-cloud-files
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000
AWS_S3_PATH_STYLE_ACCESS=true
AWS_CLOUDFRONT_ENABLED=false
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY_PEM=

# Local MinIO Credentials (used by infra/docker/docker-compose.yml)
MINIO_ROOT_USER=orbit_minio
MINIO_ROOT_PASSWORD=orbit_minio_dev
# Set these when running Spring Boot locally against MinIO with AWS_S3_ENABLED=true:
# AWS_ACCESS_KEY_ID=orbit_minio
# AWS_SECRET_ACCESS_KEY=orbit_minio_dev
