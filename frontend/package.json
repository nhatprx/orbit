{
  "name": "orbit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync:excalidraw-fonts && npm run sync:material-icons",
    "prebuild": "npm run sync:excalidraw-fonts && npm run sync:material-icons",
    "build": "tsc -b && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "ponytail": "node ../ponytail/check.mjs",
    "sync:excalidraw-fonts": "node -e \"const fs=require('node:fs');const src='node_modules/@excalidraw/excalidraw/dist/prod/fonts';if(fs.existsSync(src)){fs.rmSync('public/fonts',{recursive:true,force:true});fs.mkdirSync('public',{recursive:true});fs.cpSync(src,'public/fonts',{recursive:true});}\"",
    "sync:material-icons": "node -e \"const fs=require('node:fs');const src='node_modules/material-icon-theme/icons';if(fs.existsSync(src)){fs.rmSync('public/material-icons',{recursive:true,force:true});fs.mkdirSync('public',{recursive:true});fs.cpSync(src,'public/material-icons',{recursive:true});}\""
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@univerjs/preset-docs-core": "^1.6.0",
    "@univerjs/preset-sheets-core": "^1.6.0",
    "@univerjs/presets": "^1.6.0",
    "@univerjs/slides": "^1.3.1",
    "@univerjs/slides-ui": "^1.3.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "lucide-react": "^0.475.0",
    "marked": "^18.2.1",
    "material-icon-theme": "^5.40.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.34.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.34.8",
    "@radix-ui/react-tabs": "^1.2.1",
    "@univerjs/core": "1.6.0",
    "@univerjs/design": "1.6.0",
    "@univerjs/docs": "1.6.0",
    "@univerjs/docs-ui": "1.6.0",
    "@univerjs/drawing": "1.6.0",
    "@univerjs/icons": "1.50.0",
    "@univerjs/protocol": "1.6.0",
    "@univerjs/rpc": "1.6.0",
    "@univerjs/themes": "1.6.0",
    "@univerjs/ui": "1.6.0"
  }
}
