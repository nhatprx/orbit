aws_region  = "ap-southeast-1"
environment = "prod"
bucket_name = "orbit-cloud-files-815802019553"

allowed_cors_origins = [
  "https://orbit.nhatprx.com",
  "http://localhost:5173"
]

# Optional: attach the generated IAM policy directly to your existing EC2 IAM role
ec2_role_name = ""

# Optional: custom CloudFront domain (requires ACM certificate in us-east-1)
cloudfront_aliases             = []
cloudfront_acm_certificate_arn = ""

# Paste the contents of cloudfront_public_key.pem generated via OpenSSL
cloudfront_public_key_pem = <<-EOT
-----BEGIN PUBLIC KEY-----
REPLACE_WITH_RSA_2048_PUBLIC_KEY_PEM
-----END PUBLIC KEY-----
EOT
