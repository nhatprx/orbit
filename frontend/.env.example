# Orbit Frontend Environment Template (Vite)
# Copy this file to frontend/.env. Never commit real secrets.
# Use the live EC2 backend URL to develop frontend locally without running backend:
VITE_API_BASE_URL=https://api.orbit.nhatprx.com
# Workspaces, projects, roles, invitations and chat need a backend that includes Flyway
# migrations V2 to V4. If the deployed backend is older, run the backend locally instead:
# VITE_API_BASE_URL=http://localhost:8080
