# Orbit Environment Template (Primary Dev Workflow: Local BE/FE -> Remote Dev Server)
# Copy this file to .env for local configuration. Never commit real secrets.
# Primary setup: run Spring Boot + Vite locally against remote Dev Server (RDS, Redis, AWS S3).
# For offline/outage local Docker fallback, uncomment the fallback section at the bottom of this file.

# Frontend (Vite)
# Point to local Spring Boot backend (override with https://api.orbit.nhatprx.com for FE-only work)
VITE_API_BASE_URL=http://localhost:8080

# PostgreSQL (Remote Dev Server RDS)
SPRING_DATASOURCE_URL=jdbc:postgresql://replace-with-dev-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/orbit?sslmode=require
SPRING_DATASOURCE_USERNAME=orbit
SPRING_DATASOURCE_PASSWORD=replace-with-dev-rds-password

# Redis (Remote Dev Server)
SPRING_REDIS_HOST=replace-with-dev-server-host-or-ip
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=replace-with-dev-redis-password

# Backend Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Workspace Platform (optional; defaults shown)
ORBIT_WORKSPACE_RETENTION_DAYS=30
ORBIT_WORKSPACE_PURGE_ENABLED=true
ORBIT_WORKSPACE_PURGE_CRON=0 15 * * * *
ORBIT_INVITATION_EXPIRY_DAYS=7
# Keep true on every deployed instance (Redis pub/sub chat fan-out and rate limiting)
ORBIT_CHAT_REDIS_ENABLED=true
# WebRTC ICE servers for Voice rooms (CSV of STUN/TURN URLs or JSON RTCIceServer array)
ORBIT_VOICE_ICE_SERVERS=stun:stun.l.google.com:19302

# Git Integration (dedicated 64-char hex secret for encrypting stored GitHub PATs)
ORBIT_GIT_ENCRYPTION_SECRET=replace-with-a-64-char-random-hex-secret-for-git-token-encryption

# JWT Authentication
JWT_SECRET=replace-with-a-64-char-random-secret-key-for-hs256-signing
JWT_EXPIRATION_SECONDS=3600
JWT_REMEMBER_ME_EXPIRATION_SECONDS=2592000

# Google OAuth2
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# GitHub OAuth2
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# AWS S3 Storage & Cloud Files (Real AWS S3 Dev Bucket; uses ~/.aws/credentials or AWS_* keys)
AWS_S3_ENABLED=true
AWS_S3_BUCKET=orbit-storage-815802019553
AWS_REGION=ap-southeast-1
AWS_S3_PRESIGN_DURATION_MINUTES=15
AWS_S3_PUBLIC_BASE_URL=
AWS_CLOUD_FILES_BUCKET=orbit-cloud-files-dev
# Keep endpoints empty and path-style false for real AWS S3
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_ENDPOINT=
AWS_S3_PATH_STYLE_ACCESS=false
AWS_CLOUDFRONT_ENABLED=false
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY_PEM=
# Optional explicit AWS credentials if not using ~/.aws/credentials:
# AWS_ACCESS_KEY_ID=replace-with-dev-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=replace-with-dev-aws-secret-access-key

# ==============================================================================
# OFFLINE / OUTAGE LOCAL FALLBACK (infra/docker/docker-compose.yml)
# Uncomment and override the values above when Dev Server or AWS is unreachable.
# ==============================================================================
# POSTGRES_DB=orbit
# POSTGRES_USER=orbit
# POSTGRES_PASSWORD=orbit_dev
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orbit
# SPRING_DATASOURCE_USERNAME=orbit
# SPRING_DATASOURCE_PASSWORD=orbit_dev
# SPRING_REDIS_HOST=localhost
# SPRING_REDIS_PORT=6379
# SPRING_REDIS_PASSWORD=
# AWS_CLOUD_FILES_BUCKET=orbit-cloud-files
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000
# AWS_S3_PATH_STYLE_ACCESS=true
# MINIO_ROOT_USER=orbit_minio
# MINIO_ROOT_PASSWORD=orbit_minio_dev
# AWS_ACCESS_KEY_ID=orbit_minio
# AWS_SECRET_ACCESS_KEY=orbit_minio_dev
