# Orbit Dev Server Third-Party Services Environment Template
# Copy this file to .env alongside docker-compose.dev-server.yml on the Dev Server host.
# Never commit real secrets, credentials, or keys to Git.

# Shared Redis (restrict port 6379 to developer IPs / VPN via AWS Security Group)
REDIS_PASSWORD=replace-with-strong-dev-redis-password
REDIS_BIND_ADDRESS=0.0.0.0
REDIS_PORT=6379
