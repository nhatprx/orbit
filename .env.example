# Orbit Environment Template (Local Development)
# Copy this file to .env for local configuration. Never commit real secrets.

# Frontend (Vite)
# Point to the live EC2 backend so you do not need to run backend locally:
VITE_API_BASE_URL=https://api.orbit.nhatprx.com

# PostgreSQL (only required if running backend locally)
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orbit
SPRING_DATASOURCE_USERNAME=orbit
SPRING_DATASOURCE_PASSWORD=orbit_dev

# Redis (only required if running backend locally)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Backend Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=replace-with-a-64-char-random-secret-key-for-hs256-signing
JWT_EXPIRATION_SECONDS=3600
JWT_REMEMBER_ME_EXPIRATION_SECONDS=2592000

# Google OAuth2
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# GitHub OAuth2
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# AWS S3 Storage
AWS_S3_ENABLED=false
AWS_S3_BUCKET=orbit-storage-815802019553
AWS_REGION=ap-southeast-1
AWS_S3_PRESIGN_DURATION_MINUTES=15
