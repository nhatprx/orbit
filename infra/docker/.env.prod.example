# Orbit Production Environment Template (/opt/orbit/.env)
# Copy this file to /opt/orbit/.env on the EC2 host and replace all placeholder values.
# Never commit real secrets, credentials, or keys to Git.

# Container Registry
ECR_REGISTRY=815802019553.dkr.ecr.ap-southeast-1.amazonaws.com
BACKEND_TAG=latest
FRONTEND_TAG=latest

# AWS RDS PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://replace-with-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/orbit?sslmode=require
SPRING_DATASOURCE_USERNAME=orbit
SPRING_DATASOURCE_PASSWORD=replace-with-strong-rds-password

# Redis (internal Docker service)
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Backend Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://orbit.nhatprx.com,http://localhost:5173
FRONTEND_URL=https://orbit.nhatprx.com

# Workspace platform (optional; the defaults are shown)
# ORBIT_WORKSPACE_RETENTION_DAYS=30
# ORBIT_WORKSPACE_PURGE_ENABLED=true
# ORBIT_WORKSPACE_PURGE_CRON=0 15 * * * *
# ORBIT_INVITATION_EXPIRY_DAYS=7
# Keep true on every deployed instance (cross-instance chat delivery and rate limiting)
# ORBIT_CHAT_REDIS_ENABLED=true

# JWT Authentication
JWT_SECRET=replace-with-a-64-char-random-secret-key-for-hs256-signing
JWT_EXPIRATION_SECONDS=3600
JWT_REMEMBER_ME_EXPIRATION_SECONDS=2592000

# OAuth2 Providers
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# AWS S3 Storage (authenticated via EC2 IAM Instance Profile)
AWS_S3_ENABLED=true
AWS_S3_BUCKET=orbit-storage-815802019553
AWS_REGION=ap-southeast-1
AWS_S3_PRESIGN_DURATION_MINUTES=15
# Optional CloudFront or public CDN base URL for serving S3 objects (leave empty to use presigned GET URLs)
AWS_S3_PUBLIC_BASE_URL=

# Cloud Files (dedicated private S3 bucket + CloudFront Signed URLs via OAC)
AWS_CLOUD_FILES_BUCKET=orbit-cloud-files-815802019553
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_ENDPOINT=
AWS_S3_PATH_STYLE_ACCESS=false
AWS_CLOUDFRONT_ENABLED=true
AWS_CLOUDFRONT_DOMAIN=replace-with-distribution.cloudfront.net
AWS_CLOUDFRONT_KEY_PAIR_ID=replace-with-cloudfront-public-key-id
# Single-line PEM with literal \n escapes (never commit real private keys)
AWS_CLOUDFRONT_PRIVATE_KEY_PEM=
